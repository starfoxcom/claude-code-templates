#     echo "   Types: feat, fix, refactor, perf, test, docs, chore, style, data"
#     echo "   See .claude/rules/git.md for details."
#     exit 1
#   }
#
#   .husky/pre-push
#   ---------------
#   {{TEST_COMMAND}}   # comment out if the suite is too slow for pre-push; rely on CI instead

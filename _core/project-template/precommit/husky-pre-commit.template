# Husky pre-commit hook — fast, language-agnostic checks before each commit
# https://typicode.github.io/husky
#
# Activate in this repo: npm install --save-dev husky && npx husky init
# (husky v9+: a hook is a plain shell script — no sourcing boilerplate needed.)
#
# This template is generic. Tighten the commands to your project's actual
# lint/typecheck. The setup form's stack-commands chip selector auto-suggests
# these; what you see here is the structural skeleton.

# Lint only the staged files (Added / Copied / Modified).
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED" ]; then
  {{LINT_COMMAND}} $STAGED
fi
#   Examples ({{LINT_COMMAND}}):
#     npm:       npx eslint --fix
#     python:    ruff check --fix
#     rust:      cargo fmt --
#     flutter:   dart format

# Project-wide type check.
{{TYPECHECK_COMMAND}}
#   Examples ({{TYPECHECK_COMMAND}}):
#     ts:        npx tsc --noEmit
#     python:    mypy .
#     rust:      cargo check --all-targets

# ---------------------------------------------------------------------------
# Husky uses one file per git hook. To enforce conventional commit messages and
# run tests before push, add these sibling hooks:
#
#   .husky/commit-msg
#   -----------------
#   grep -qE '^(feat|fix|refactor|perf|test|docs|chore|style|data)(\([a-z0-9_-]+\))?: .{1,72}$' "$1" || {

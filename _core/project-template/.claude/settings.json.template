{
<!-- TOGGLE:attribution_guard START -->
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
<!-- TOGGLE:attribution_guard END -->
<!-- TOGGLE:guard_hooks_repo START -->
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
<!-- TOGGLE:attribution_guard START -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" && exec sh \"$0\" no-ai-attribution' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10
          },
<!-- TOGGLE:attribution_guard END -->
          {
            "type": "command",
            "command": "sh -c 'test -f \"$0\" && exec sh \"$0\" push-guard' \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
<!-- TOGGLE:guard_hooks_repo END -->
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}

# Routine PR review — Sonnet 4.6, binary 🔴/🟢 verdict
#
# Architecture: two independent required status checks fold into the merge
# gate via branch protection (NOT via in-workflow comment correlation):
#   1. `Evaluate review outcome` — routine tier (this workflow). Required.
#   2. `Claude On-Demand`        — deep tier (claude.yml). Required when
#                                  branch protection is configured to require it.
#
# The `Claude On-Demand` check is created on the PR HEAD SHA at workflow
# start (via the Checks API so it shows up on the PR's status rollup) and
# walks through this lifecycle:
#   • PR opens                    → status=in_progress  ("Waiting for routine review")
#   • Triage non-reviewable diff  → conclusion=skipped  ("Diff non-reviewable")
#   • Sonnet completes, no escal. → conclusion=skipped  ("No escalation")
#   • Sonnet escalates            → status=in_progress  ("Deep review in progress")
#   • Opus completes              → success / failure   (claude.yml PATCHes)
#
# All terminal states (skipped, success) pass branch protection; in_progress
# blocks merge with a spinner visible in the PR status rollup; failure blocks
# merge with a red X.
#
# POST-BIND PREREQUISITES (workflow is a no-op until BOTH are done):
#   1. Add CLAUDE_CODE_OAUTH_TOKEN to repo secrets
#      (GitHub UI: Settings → Secrets and variables → Actions → New repository secret).
#   2. This file must live on the repo's GITHUB DEFAULT BRANCH for GitHub Actions to
#      trigger it on future PRs. If your repo's default branch is not where day-to-day
#      PRs target (e.g., Gitflow: default={{MAIN_BRANCH}}, PRs target {{DEV_BRANCH}}),
#      land this file on {{MAIN_BRANCH}} first via a hotfix/* branch, then cascade
#      {{MAIN_BRANCH}} → {{DEV_BRANCH}}. Workflow files installed only on a non-default
#      branch will NEVER fire.
#   3. (Recommended) Add `Evaluate review outcome` AND `Claude On-Demand` to
#      required status checks under your branch protection ruleset. Both are
#      created against the PR HEAD SHA. Adding both makes deep-tier verdicts
#      actually gate merge; omitting `Claude On-Demand` leaves the check
#      visible but advisory.
#
# PERMANENT LIMITATION — claude-code-review.yml edits require admin-bypass:
#   The Anthropic Claude Code GitHub App validates that the workflow file on a PR's
#   head ref is byte-identical to the version on the default branch before granting
#   an OIDC-exchanged token. Any PR that edits .github/workflows/claude-code-review.yml
#   therefore fails the token exchange and the routine review action cannot post a
#   verdict. Confirm via `gh run view --job <id> --log-failed` and admin-bypass once.

name: Claude Code Review

on:
  pull_request:
    types: [opened, synchronize, reopened]
    <!-- TOGGLE:branching_model_gitflow START -->
    branches: [{{MAIN_BRANCH}}, {{DEV_BRANCH}}]
    <!-- TOGGLE:branching_model_gitflow END -->
    <!-- TOGGLE:branching_model_trunk START -->
    branches: [{{MAIN_BRANCH}}]
    <!-- TOGGLE:branching_model_trunk END -->

concurrency:
  # Cancel in-flight reviews when a newer commit lands on the same PR.
  group: claude-review-pr-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  init-deep-check:
    name: Init deep-tier check
    # Always run — every PR gets a `Claude On-Demand` check on its HEAD SHA
    # so branch protection has something to evaluate. The check starts at
    # status=in_progress ("Waiting for routine review to evaluate"), then
    # downstream jobs PATCH it through the lifecycle:
    #   • triage non-reviewable / Sonnet no escalation → conclusion=skipped
    #   • Sonnet escalates → status=in_progress titled "Deep review in progress"
    #   • Opus completes → conclusion=success/failure (claude.yml)
    runs-on: ubuntu-latest
    permissions:
      contents: read
      checks: write
      pull-requests: read
    steps:
      - name: Create Claude On-Demand check at in_progress on PR HEAD SHA
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          HEAD_SHA="${{ github.event.pull_request.head.sha }}"
          REPO="${{ github.repository }}"

          # Idempotent: if the check already exists on this HEAD SHA, do
          # nothing. Re-running this job on a rerun_failed scenario must not
          # overwrite a deep-tier-set conclusion.
          EXISTING=$(gh api \
            "repos/$REPO/commits/$HEAD_SHA/check-runs?check_name=Claude%20On-Demand&per_page=100" \
            --jq '[.check_runs[] | select(.name == "Claude On-Demand")] | first | .id // empty')
          if [ -n "$EXISTING" ]; then
            echo "::notice::Claude On-Demand check already exists on $HEAD_SHA (id=$EXISTING) — skipping create"
            exit 0
          fi

          gh api "repos/$REPO/check-runs" -X POST \
            -F name="Claude On-Demand" \
            -F head_sha="$HEAD_SHA" \
            -F status="in_progress" \
            -F "output[title]=Waiting for routine review to evaluate" \
            -F "output[summary]=The routine review (Sonnet) is evaluating whether deep-tier review is needed. This check will resolve to skipped (no escalation) or in_progress → success/failure (escalated to Opus)."
          echo "::notice::Created in_progress Claude On-Demand check on $HEAD_SHA"

  triage:
    name: Diff triage
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      run_review: ${{ steps.classify.outputs.run_review }}
    steps:
      - name: Classify diff
        id: classify
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR=${{ github.event.pull_request.number }}
          REPO=${{ github.repository }}
          gh pr diff $PR --repo $REPO --name-only > /tmp/changed_files.txt
          # Reviewable extensions — customize for your stack
          if grep -qE '\.(py|ts|tsx|js|jsx|rs|go|java|cpp|h|hpp|c|gd|dart|rb|kt|swift|cs)$' /tmp/changed_files.txt; then
            echo "Reviewable changes detected; running review."
            echo "run_review=true" >> "$GITHUB_OUTPUT"
          else
            echo "Diff has no reviewable source files — skipping review."
            echo "run_review=false" >> "$GITHUB_OUTPUT"
          fi

  claude-review:
    name: Auto review (Sonnet 4.6)
    needs: [triage, init-deep-check]
    if: needs.triage.outputs.run_review == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write
      actions: read
      # Needed so the post-action Resolve step can PATCH the Claude On-Demand
      # check based on whether routine auto-escalated.
      checks: write
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"

      # ── Pre-screen: deterministic Python checks over the diff ────────────────
      # Catches mechanical rule violations before Sonnet sees them. Sonnet then
      # trusts the report and spends turns on judgment work — NOT re-discovering
      # grep-able patterns. This is what makes the `Bash(gh *),Read` allowlist
      # the right size: Sonnet doesn't need `cat`/`grep`/`wc` because the pre-
      # screen already did that work.
      - name: Pre-screen PR diff
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          PR=${{ github.event.pull_request.number }}
          REPO=${{ github.repository }}

          gh pr diff $PR --repo $REPO > /tmp/pr_diff.txt
          gh pr diff $PR --repo $REPO --name-only > /tmp/changed_files.txt

          python3 - << 'PYEOF'
          import os
          import re

          PR = os.environ.get('PR_NUMBER', '?')

          with open('/tmp/pr_diff.txt') as f:
              diff = f.read()
          with open('/tmp/changed_files.txt') as f:
              changed = [l.strip() for l in f if l.strip()]

          # Parse the diff into per-file added-line sections.
          per_file_added = {}
          for sec in re.split(r'(?=^diff --git )', diff, flags=re.MULTILINE):
              m = re.search(r'^diff --git a/(.+?) b/', sec, re.MULTILINE)
              if not m:
                  continue
              fname = m.group(1)
              added = [l[1:] for l in sec.splitlines() if l.startswith('+') and not l.startswith('+++')]
              per_file_added[fname] = added

          violations = []
          warnings   = []
          deep_paths = []  # populated below when auto-fire is enabled

          # ── Check 1: AI-attribution scan ─────────────────────────────────────
          # Scans ADDED lines for the AI-attribution patterns defined in
          # .claude/rules/git.md. The regexes are encoded in ai_pats below
          # (kept structural — readers consult ai_pats, not this comment,
          # to avoid the comment itself re-tripping the scanner on future
          # edits to this workflow file).
          ai_pats = [
              re.compile(r'Co-Authored-By:\s*Claude', re.IGNORECASE),
              re.compile(r'Generated\s+with\s+\[?Claude\s+Code', re.IGNORECASE),
              re.compile(r'claude\.(?:com|ai)\b', re.IGNORECASE),
              re.compile(r'🤖\s*Generated', re.IGNORECASE),
          ]
          for fname, lines in per_file_added.items():
              for line in lines:
                  for pat in ai_pats:
                      if pat.search(line):
                          violations.append(f'AI_ATTRIBUTION: {fname}: {line.strip()[:120]}')
                          break

          # ── Check 2: Categorize files ────────────────────────────────────────
          # Customize ARCH_PREFIXES / ARCH_FILES to flag your project's highest-
          # blast-radius paths. Sonnet reads these files first.
          ARCH_PREFIXES = ()  # e.g. ('src/core/', 'src/auth/')
          ARCH_FILES    = set()  # e.g. {'schema.sql', 'openapi.yaml'}
          arch_critical, docs, other_code = [], [], []
          for f in changed:
              if any(f.startswith(p) for p in ARCH_PREFIXES) or f in ARCH_FILES:
                  arch_critical.append(f)
              elif f.endswith('.md'):
                  docs.append(f)
              else:
                  other_code.append(f)

          <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
          # ── Check 3: Deep-review trigger surface ─────────────────────────────
          # Customize DEEP_PREFIXES / DEEP_FILES for your project's highest-risk
          # paths (auth, parsers, public API, migrations, save/load formats).
          # See .claude/rules/review-tiers.md for the canonical trigger list.
          DEEP_PREFIXES = ()  # e.g. ('src/auth/', 'src/parsers/')
          DEEP_FILES    = set()  # e.g. {'migrations/'}
          deep_paths = [
              f for f in changed
              if any(f.startswith(p) for p in DEEP_PREFIXES)
              or any(f.startswith(str(d)) for d in DEEP_FILES)
          ]
          <!-- TOGGLE:github_actions_deep_review_auto_fire END -->

          # ── Write the review context ─────────────────────────────────────────
          with open('/tmp/review_context.md', 'w') as out:
              out.write(f'# Pre-screen report for PR #{PR}\n\n')

              if violations:
                  out.write(f'## Pre-screen violations ({len(violations)}) — likely 🔴 unless you can refute each\n\n')
                  for v in violations:
                      out.write(f'- `{v}`\n')
                  out.write('\n')
              else:
                  out.write('## Pre-screen violations: none\n\n')

              if warnings:
                  out.write(f'## Pre-screen warnings ({len(warnings)}) — reviewer judges\n\n')
                  for w in warnings:
                      out.write(f'- `{w}`\n')
                  out.write('\n')

              <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
              if deep_paths:
                  out.write('## Deep-review trigger surface — auto-escalation REQUIRED (Step 4)\n\n')
                  out.write('These paths are on the deep-review trigger list. Apply the `needs-deep-review` label AND post the structured `@claude review this PR` comment in Step 4:\n\n')
                  for p in deep_paths:
                      out.write(f'- `{p}`\n')
                  out.write('\n')
              else:
                  out.write('## Deep-review trigger surface: none (Step 4 skipped)\n\n')
              <!-- TOGGLE:github_actions_deep_review_auto_fire END -->

              out.write('## Architecture-critical files (READ THESE)\n\n')
              if arch_critical:
                  for f in arch_critical:
                      out.write(f'- `{f}`\n')
              else:
                  out.write('_(none)_\n')
              out.write('\n')

              out.write('## Docs / markdown changes (low-risk, scan only)\n\n')
              if docs:
                  for f in docs:
                      out.write(f'- `{f}`\n')
              else:
                  out.write('_(none)_\n')
              out.write('\n')

              out.write('## Other code changes\n\n')
              if other_code:
                  for f in other_code:
                      out.write(f'- `{f}`\n')
              else:
                  out.write('_(none)_\n')

          print(f'Pre-screen complete. Violations={len(violations)}, Warnings={len(warnings)}, Deep-trigger={len(deep_paths)}, Arch-critical={len(arch_critical)}')
          PYEOF

          echo "--- review_context.md ---"
          cat /tmp/review_context.md

      - name: Run Claude Code Review
        id: claude-review
        # Pinned to v1's resolved SHA (resolved 2026-05-04). The bare `@v1`
        # or `@beta` floats — silent behavior changes from auto-updates burned
        # other projects already. Update via
        #   curl -s "https://api.github.com/repos/anthropics/claude-code-action/git/refs/tags/v1" | jq -r '.object.sha'
        # confirm the diff, then bump here AND in `.github/workflows/claude.yml`.
        uses: anthropics/claude-code-action@8c196b2f61a66bfdf93322bde3a3e668669089ed  # v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          show_full_output: false
          claude_args: '--allowedTools "Bash(gh *),Read" --max-turns 50 --model claude-sonnet-4-6'
          prompt: |
            Review PR ${{ github.event.pull_request.number }} in ${{ github.repository }} for **{{PROJECT_NAME}}** — {{ONE_LINE_DESCRIPTION}}.

            ## Step 1 — Read the pre-screen report

            Read `/tmp/review_context.md`. It contains:
            - **Pre-screen violations** — mechanical rule-breakage already detected (AI-attribution markers in added lines). Each violation is likely 🔴 unless you can refute it from the diff.
            - **Pre-screen warnings** — issues you should judge.
            <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
            - **Deep-review trigger surface** — if non-empty, Step 4 (label + `@claude` trigger) is mandatory.
            <!-- TOGGLE:github_actions_deep_review_auto_fire END -->
            - **Categorized file lists** — architecture-critical files to READ first, then docs (scan only), then other code.

            Then read the PR diff once for the full context: `gh pr diff ${{ github.event.pull_request.number }} --repo ${{ github.repository }}`.

            **Trust the pre-screen.** Do NOT re-run the mechanical checks it already ran (AI-attribution scan). Use Read for architecture-critical files; use `gh pr diff` once for the diff; spend remaining turns on judgment work — architectural invariants, semantic regressions, contract drift. The `Bash(gh *),Read` allowlist is exactly sized for this contract — don't try `cat`, `grep`, `wc`, `head`, or `git diff`; they will be denied.

            ## Step 2 — Architectural review

            Read ONLY the files most likely to contain risk. Then expand outward if the architecture review surfaces a concern.

            **Project-specific invariants to verify (customize this list for {{PROJECT_NAME}}):**

            1. Add your project's highest-risk invariants here — e.g., API contract stability, migration safety, auth boundary correctness, schema evolution.
            2. Cross-cutting concerns: are changes to shared utilities backward-compatible?
            3. No AI-attribution markers in added code or commit messages (per `.claude/rules/git.md`).

            ## Step 2.5 — Decide whether to escalate (do not post yet)

            Escalation is *orthogonal* to the verdict — it's "deeper look requested," not a blocker.

            <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
            **Auto-escalate when the pre-screen reports a non-empty deep-review trigger surface.** Otherwise apply judgment: escalate when (a) the concern is about correctness not style, (b) you can articulate a specific reason an Opus reviewer would catch what you cannot, (c) you would not stake the merge on your own verdict for that concern.
            <!-- TOGGLE:github_actions_deep_review_auto_fire END -->
            <!-- TOGGLE:github_actions_deep_review_auto_fire START -->

            **Do NOT mark for escalation:** docs, comments, formatting, naming nits, "consider extracting", pure refactors with no behavior change.
            <!-- TOGGLE:github_actions_deep_review_auto_fire END -->

            ## Step 3 — Post the verdict comment FIRST

            Command: `gh pr comment ${{ github.event.pull_request.number }} --repo ${{ github.repository }} --body "BODY"`

            The verdict lands BEFORE the escalation comment so PR readers see the decision first.

            **Verdict is BINARY** — only 🔴 (Blocking) or 🟢 (LGTM). No middle ground.

            **⚠️ FAIL-CLOSED ENFORCEMENT — read before posting:** The `Evaluate review outcome` job parses the comment body via `grep -E "🔴|🟢" | tail -n 1`. A verdict line without one of those two emoji characters is treated as a MISSING verdict and the gate FAILS CLOSED. There is no fallback parser, no fuzzy match, no synonym table. The emoji is the contract. PRs with a bare `LGTM` line are not mergeable — the substance does not matter; the gate cannot tell.

            Body MUST:
            - Be titled `## Code Review — {{PROJECT_NAME}}`
            - End with EXACTLY one of these as the FINAL line of the comment (no trailing prose after):
              - `🟢 LGTM`
              - `🔴 Blocking — must fix`

            **WRONG formats — every one of these fails the gate:**
            - `LGTM` (missing 🟢 prefix — the most common mistake; do not do this)
            - `LGTM ✅` / `✅ LGTM` (wrong emoji — parser matches 🟢 only, not ✅)
            - `Blocking` or `Blocking — must fix` (missing 🔴 prefix)
            - `🟢 LGTM with caveats` / `🟢 LGTM — minor nit` (caveats forbidden; the binary rule below forces 🔴)
            - Any verdict line followed by trailing prose (`🟢 LGTM, ship it!` — must be the FINAL line, nothing after)

            **Self-check immediately before invoking `gh pr comment`:** Look at the literal last line of your draft body. Does it start with `🟢` or `🔴`? If not — STOP, fix the line, re-check. The single most common review-quality failure is posting `LGTM` without the emoji, which blocks otherwise-clean PRs from merging.

            **BINARY VERDICT RULE:**
            - 🟢 LGTM ONLY when fully clean — zero caveats, zero minors, zero nits, zero "with caveats" headings.
            - 🔴 Blocking when ANY real finding exists, regardless of framing.
            - DROP style preferences, micro-optimisations, future-proofing for hypothetical changes, "consider extracting" suggestions. Don't list them as non-blocking; just drop them.

            **MANDATORY when you marked the PR for escalation in Step 2.5 (path-based OR uncertainty-based):** before the final verdict line, append a `### 🟡 Uncertainty surfaced — needs-deep-review requested` section. PR readers must see *what specifically* the deep tier is being asked to verify, not just *that* it was flagged. An escalation without a 🟡 section in the verdict above it is unmotivated and degrades the deep tier's signal quality — readers see the label / trigger but not the rationale.

            Format (this block goes BEFORE the final verdict line; verdict stays binary 🟢/🔴):

            ```
            ### 🟡 Uncertainty surfaced — needs-deep-review requested

            - `<file:line>` — <what specifically concerns you about this change in 1 sentence>.
              **Why I am not confident:** <one sentence on the limit of your analysis — what you cannot fully verify from the diff/the files you read>.
              **What I want Opus to verify:** <one sentence naming the concrete check — invariant, contract, edge case>.
            - ...
            ```

            For escalated paths with no genuine uncertainty in your own read: still enumerate at least one concrete concern about THIS PR's changes on those paths — what regression a deep tier should mechanically rule out, what invariant could silently break. "Path is on the escalate list" alone is NOT a sufficient 🟡 entry. If you truly have nothing concrete to surface, that is signal that escalation is wrong for this PR — reconsider Step 2.5.

            🟡 is NEVER the verdict line. A 🟢 verdict CAN carry a 🟡 section (genuinely-clean PR where the deep tier should still verify a specific concern). A 🔴 verdict CAN ALSO carry a 🟡 section (blocking findings plus uncertain ones for Opus). Binary verdict + optional 🟡 section are independent dimensions.

            <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
            ## Step 4 — IF you escalated in Step 2.5: apply label + post @claude trigger

            Only run Step 4 if Step 2.5 marked the PR for escalation. Skip otherwise.

            Do BOTH of the following — the label and the comment have different lifecycles:

            **A. Apply the label (idempotent — safe to re-apply if already present):**
            ```
            gh pr edit ${{ github.event.pull_request.number }} --repo ${{ github.repository }} --add-label needs-deep-review
            ```

            **B. Post a fresh `@claude` comment EVERY escalating run, no exceptions:**
            ```
            gh pr comment ${{ github.event.pull_request.number }} --repo ${{ github.repository }} --body "@claude review this PR — depth pass on <focus>.

            <One-paragraph context: what the PR ships and why the risk surface is bigger than the diff suggests.>

            **Numbered invariants ranked by priority:**
            1. **<file:line>** — <invariant + how it could break>
            2. ...

            **Out of scope:** <list of intentional deferrals>

            **Verdict format — BINARY, no in-between.** Same rule as the routine tier:
            - 🟢 LGTM ONLY when fully clean — zero caveats, zero minors, zero nits.
            - 🔴 Blocking when ANY real finding exists, regardless of framing.
            - DROP style preferences and micro-optimisations entirely.

            **Output spec:** bullet-point findings ranked by severity with file:line citations. The verdict line is the FINAL line of the comment — `🟢 LGTM` or `🔴 Blocking — must fix`, no trailing prose."
            ```

            **CRITICAL — do not skip step B because a prior `@claude` comment exists on this PR.** The `claude.yml` deep-review workflow only fires on the `issue_comment` event for the CURRENT comment — it does not re-evaluate older comments when a new push lands. Every escalation must repost a fresh comment, and the comment body MUST start with the literal `@claude` token (not in backticks, not in a markdown header) so both the workflow's `if: contains(body, '@claude review this PR')` condition AND the action's internal trigger detector evaluate true.
            <!-- TOGGLE:github_actions_deep_review_auto_fire END -->

      # ── Resolve Claude On-Demand check based on escalation state ──────────
      # Runs AFTER the action step above so we observe the label-applied state
      # the action just produced (or that a maintainer manually applied). The
      # check (created at in_progress by init-deep-check) is PATCHed to one
      # of two states:
      #   • No needs-deep-review label → conclusion=skipped (passes branch
      #     protection; visually clear "this didn't run").
      #   • Label applied → status=in_progress with updated title "Deep
      #     review in progress" — branch protection blocks merge until
      #     claude.yml PATCHes to success/failure.
      - name: Resolve Claude On-Demand check post-routine
        if: always() && steps.claude-review.conclusion != 'cancelled'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR="${{ github.event.pull_request.number }}"
          REPO="${{ github.repository }}"
          HEAD_SHA="${{ github.event.pull_request.head.sha }}"

          CHECK_ID=$(gh api \
            "repos/$REPO/commits/$HEAD_SHA/check-runs?check_name=Claude%20On-Demand&per_page=100" \
            --jq '[.check_runs[] | select(.name == "Claude On-Demand")] | first | .id // empty')
          if [ -z "$CHECK_ID" ]; then
            echo "::error::Claude On-Demand check not found on $HEAD_SHA — init-deep-check must have skipped or failed"
            exit 1
          fi

          # ── Terminal-state guard ──────────────────────────────────────────
          # If claude.yml's Evaluate step already PATCHed the check to a
          # terminal state (success or failure), do NOT overwrite. Scenarios:
          # (a) maintainer manually @claude-triggered before routine
          # completed and Opus finished first; (b) "Re-run all jobs" on the
          # routine workflow after Opus has set a terminal state. The
          # `skipped` and `in_progress` states ARE safe to overwrite —
          # they're set by this routine workflow, not by claude.yml's
          # authoritative Evaluate step.
          EXISTING_STATUS=$(gh api "repos/$REPO/check-runs/$CHECK_ID" --jq '.status')
          EXISTING_CONCLUSION=$(gh api "repos/$REPO/check-runs/$CHECK_ID" --jq '.conclusion // ""')
          if [ "$EXISTING_STATUS" = "completed" ] && { [ "$EXISTING_CONCLUSION" = "success" ] || [ "$EXISTING_CONCLUSION" = "failure" ]; }; then
            echo "::notice::Claude On-Demand check $CHECK_ID is at terminal state ($EXISTING_CONCLUSION) — Opus has spoken; routine Resolve will not overwrite"
            exit 0
          fi

          LABELS=$(gh pr view "$PR" --repo "$REPO" --json labels --jq '[.labels[].name] | join(",")')
          if echo "$LABELS" | grep -q "needs-deep-review"; then
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="in_progress" \
              -F "output[title]=Deep review in progress" \
              -F "output[summary]=needs-deep-review applied. Waiting for the Opus deep-tier verdict (claude.yml will PATCH this check on completion)."
            echo "::notice::Set Claude On-Demand check $CHECK_ID to in_progress (escalated)"
          else
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="completed" \
              -F conclusion="skipped" \
              -F "output[title]=Deep review skipped — no escalation" \
              -F "output[summary]=Routine review found no uncertainty warranting deep-tier escalation. To request a deep review anyway, post a comment containing \`@claude review this PR — depth pass on <focus>\`."
            echo "::notice::Set Claude On-Demand check $CHECK_ID to skipped (no escalation)"
          fi

  evaluate-review-outcome:
    name: Evaluate review outcome
    needs: [triage, claude-review]
    # Runs on every PR event. MUST run for every PR (including non-reviewable
    # docs/rules/context-refresh PRs) so the branch-protection ruleset's
    # required-status-check "Evaluate review outcome" always resolves to a
    # status — `always()` keeps the gate firing even when `claude-review` is
    # skipped via the triage classifier.
    #
    # Gate logic — routine tier ONLY. The deep tier is a SEPARATE required
    # status check (`Claude On-Demand`) created/PATCHed via the Checks API
    # against the PR HEAD SHA. Branch protection ANDs the two checks; this
    # job does NOT need to know about the deep verdict.
    #
    #   1. Triage classified the diff as non-reviewable → auto-pass + PATCH
    #      Claude On-Demand to conclusion=skipped (otherwise it'd be stuck
    #      at in_progress and block merge on non-reviewable PRs).
    #   2. Routine review job didn't reach success → fail (action errored,
    #      OIDC tripped, workflow-validation skip, runner crash).
    #   3. Routine verdict comment missing or 🔴 → fail.
    #   4. Routine 🟢 → pass.
    if: always()
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
      # Needed for the non-reviewable-diff path to PATCH Claude On-Demand to
      # skipped — without this the deep check stays at in_progress on
      # docs/rules-only PRs and the maintainer would have to admin-bypass to
      # land them when `Claude On-Demand` is a required status check.
      checks: write
      # Needed for the current-run-started-at lookup used as the stale-verdict
      # floor. Without this the gh api call returns HTTP 403.
      actions: read
    steps:
      - name: Resolve routine verdict
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR_NUMBER="${{ github.event.pull_request.number }}"
          REPO="${{ github.repository }}"
          HEAD_SHA="${{ github.event.pull_request.head.sha }}"

          if [ "${{ needs.triage.outputs.run_review }}" != "true" ]; then
            echo "✅ Triage classified diff as non-reviewable — gate auto-passes"
            CHECK_ID=$(gh api \
              "repos/$REPO/commits/$HEAD_SHA/check-runs?check_name=Claude%20On-Demand&per_page=100" \
              --jq '[.check_runs[] | select(.name == "Claude On-Demand")] | first | .id // empty')
            if [ -n "$CHECK_ID" ]; then
              gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
                -F status="completed" \
                -F conclusion="skipped" \
                -F "output[title]=Deep review skipped — diff non-reviewable" \
                -F "output[summary]=Triage classified the diff as non-reviewable (docs, rules, manifest tweaks). Deep review not applicable."
              echo "::notice::Set Claude On-Demand check $CHECK_ID to skipped (non-reviewable diff)"
            else
              # Self-heal: init-deep-check didn't create the check (Checks API
              # 5xx, permission propagation delay on a fresh bind, runner
              # blip). Create it directly here so docs/rules-only PRs don't
              # stall in branch-protection's "Expected" state on transient
              # infra failures. The reviewable path's Resolve step exits 1
              # in the same scenario (clearer signal there); the
              # non-reviewable path self-heals to preserve the fast-path
              # ~30-second auto-merge UX downstream users expect.
              echo "::warning::Claude On-Demand check missing on $HEAD_SHA — creating directly (init-deep-check may have failed)"
              gh api "repos/$REPO/check-runs" -X POST \
                -F name="Claude On-Demand" \
                -F head_sha="$HEAD_SHA" \
                -F status="completed" \
                -F conclusion="skipped" \
                -F "output[title]=Deep review skipped — diff non-reviewable" \
                -F "output[summary]=Triage classified the diff as non-reviewable. init-deep-check did not create the check earlier in this run (Checks API blip or permission propagation delay); this step recovered by creating it directly."
              echo "::notice::Created Claude On-Demand check directly at skipped (recovery path)"
            fi
            exit 0
          fi
          if [ "${{ needs.claude-review.result }}" != "success" ]; then
            echo "::error::Claude review job did not complete successfully (result: ${{ needs.claude-review.result }})"
            exit 1
          fi

          # ── Stale-verdict floor (current-run correlation) ─────────────────
          # `claude-review.result == success` reflects job-level exit status —
          # it's possible for the action to exit clean WITHOUT posting a
          # verdict comment (hit --max-turns, gh failure, refusal). In those
          # scenarios a naive `| last` selector on the comments endpoint
          # would pick the PRIOR push's stale 🟢, fail-opening the gate.
          # Filter comments by created_at >= this run's run_started_at: a
          # comment that belongs to the current push must have been posted
          # after the run started. New push → new run_id → new floor.
          RUN_STARTED_AT=$(gh api "repos/$REPO/actions/runs/${{ github.run_id }}" --jq '.run_started_at')
          if [ -z "$RUN_STARTED_AT" ]; then
            echo "::error::Could not resolve current run's run_started_at — refusing to evaluate verdict without stale-floor correlation"
            exit 1
          fi

          # --paginate is mandatory: the comments endpoint defaults to 30
          # per page ascending, so on a long-thread PR the verdict comment
          # lands on a later page and `| last` would silently pick a stale
          # verdict from page 1.
          ROUTINE_COMMENT=$(gh api --paginate "repos/$REPO/issues/$PR_NUMBER/comments" \
            | jq -r --arg ts "$RUN_STARTED_AT" \
                '[.[] | select(.body | contains("## Code Review — {{PROJECT_NAME}}")) | select(.created_at >= $ts)] | last | .body // ""')
          if [ -z "$ROUTINE_COMMENT" ]; then
            echo "::error::No routine review comment found at or after run_started_at $RUN_STARTED_AT — Claude did not post a verdict this run (max-turns hit, gh failure, or refusal)"
            exit 1
          fi
          # Read the LAST line of the comment that carries a verdict emoji,
          # not the whole body. A 🟢 review whose body recaps a prior 🔴
          # finding must not false-block on the recap text.
          ROUTINE_VERDICT_LINE=$(printf '%s\n' "$ROUTINE_COMMENT" | grep -E "🔴|🟢" | tail -n 1)
          if [ -z "$ROUTINE_VERDICT_LINE" ]; then
            echo "::error::Routine review comment has no 🔴/🟢 verdict line"
            exit 1
          fi
          if echo "$ROUTINE_VERDICT_LINE" | grep -qF "🔴"; then
            echo "::error::Routine review verdict: 🔴 Blocking — must fix"
            exit 1
          fi
          echo "✅ Routine review verdict: 🟢 LGTM"

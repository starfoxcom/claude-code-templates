# Routine PR review — Sonnet 4.6, binary 🔴/🟢 verdict
# Also owns the combined merge gate: routine + (when escalated) deep tier.
#
# POST-BIND PREREQUISITES (workflow is a no-op until BOTH are done):
#   1. Add CLAUDE_CODE_OAUTH_TOKEN to repo secrets
#      (GitHub UI: Settings → Secrets and variables → Actions → New repository secret).
#   2. This file must live on the repo's GITHUB DEFAULT BRANCH for GitHub Actions to
#      trigger it on future PRs. If your repo's default branch is not where day-to-day
#      PRs target (e.g., Gitflow: default={{MAIN_BRANCH}}, PRs target {{DEV_BRANCH}}),
#      land this file on {{MAIN_BRANCH}} first via a hotfix/* branch, then cascade
#      {{MAIN_BRANCH}} → {{DEV_BRANCH}}. Workflow files installed only on a non-default
#      branch will NEVER fire.
#
# PERMANENT LIMITATION — workflow-touching PRs require admin-bypass:
#   The Anthropic Claude Code GitHub App validates that the workflow file on a PR's
#   head ref is byte-identical to the version on the default branch before granting
#   an OIDC-exchanged token. Any PR that edits .github/workflows/claude*.yml therefore
#   fails the token exchange and the routine review action cannot post a verdict —
#   the gate has no comment to read, so it exits 1. The only path forward is
#   `gh pr merge --admin`. Confirm the failure mode by inspecting the `Claude review`
#   job log for "Workflow validation failed. The workflow file must exist and have
#   identical content to the version on the repository's default branch". For all
#   other PRs, wait for the verdict comment to post and never bypass on a 🔴.

name: Claude Code Review

on:
  pull_request:
    types: [opened, synchronize, reopened]
    <!-- TOGGLE:branching_model_gitflow START -->
    branches: [{{MAIN_BRANCH}}, {{DEV_BRANCH}}]
    <!-- TOGGLE:branching_model_gitflow END -->
    <!-- TOGGLE:branching_model_trunk START -->
    branches: [{{MAIN_BRANCH}}]
    <!-- TOGGLE:branching_model_trunk END -->
  issue_comment:
    types: [created]

concurrency:
  group: claude-review-pr-${{ github.event.pull_request.number || github.event.issue.number }}-${{ github.event_name }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  pull-requests: write
  issues: write
  id-token: write

jobs:
  triage:
    name: Diff triage
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    outputs:
      reviewable: ${{ steps.classify.outputs.reviewable }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Classify diff
        id: classify
        run: |
          BASE=${{ github.event.pull_request.base.sha }}
          HEAD=${{ github.event.pull_request.head.sha }}
          CHANGED=$(git diff --name-only $BASE..$HEAD)
          # Reviewable extensions — customize for your stack
          if echo "$CHANGED" | grep -qE '\.(py|ts|tsx|js|jsx|rs|go|java|cpp|h|hpp|c|gd|dart|rb|kt|swift|cs)$'; then
            echo "reviewable=true" >> $GITHUB_OUTPUT
          else
            echo "reviewable=false" >> $GITHUB_OUTPUT
          fi

  claude-review:
    name: Claude review
    needs: triage
    if: github.event_name == 'pull_request' && needs.triage.outputs.reviewable == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Pre-screen
        id: prescreen
        run: |
          BASE=${{ github.event.pull_request.base.sha }}
          HEAD=${{ github.event.pull_request.head.sha }}
          mkdir -p /tmp
          echo "# Pre-screen report for PR #${{ github.event.pull_request.number }}" > /tmp/review_context.md
          echo "" >> /tmp/review_context.md
          echo "## Files changed" >> /tmp/review_context.md
          git diff --name-only $BASE..$HEAD >> /tmp/review_context.md
          # Add project-specific mechanical checks here (e.g., raw thread usage,
          # hardcoded strings in wrong language, missing doc class XML, etc.)

      - name: Claude routine review
        uses: anthropics/claude-code-action@beta
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          model: claude-sonnet-4-6
          allowed_tools: "Bash(gh pr diff:*),Bash(gh pr view:*),Bash(git diff:*),Bash(cat /tmp/review_context.md)"
          direct_prompt: |
            You are reviewing a PR for {{PROJECT_NAME}}.

            Read /tmp/review_context.md for the pre-screen output.
            Read the PR diff: `gh pr diff ${{ github.event.pull_request.number }}`.

            Post ONE comment titled "## Code Review — {{PROJECT_NAME}}" ending with EXACTLY one of:
              - "🟢 LGTM" — when zero real findings exist (zero caveats, zero "non-blocking", zero "minor nits").
              - "🔴 Blocking — must fix" — when ANY real finding exists.

            BINARY VERDICT RULE:
            - 🟢 only when fully clean.
            - 🔴 when ANY real finding exists, regardless of framing.
            - DROP style preferences, micro-optimizations, "consider extracting" — never label them non-blocking.

            <!-- TOGGLE:github_actions_deep_review_auto_fire START -->
            UNCERTAINTY ESCALATION (independent of verdict):
            If the diff touches the deep-review trigger surface (parsing/codec/serialization,
            threading/locking, scheduler/DAG/graph algorithms, new public API/interface,
            save-load format, schema migrations, auth/authz/crypto, trust-boundary crossings),
            apply the `needs-deep-review` label AND post a structured follow-up comment:
            `@claude review this PR — depth pass on <focus area>`
            with: one-line framing, one-paragraph context, numbered priority-ranked invariants
            with file:line, explicit out-of-scope list.
            <!-- TOGGLE:github_actions_deep_review_auto_fire END -->

  evaluate-review-outcome:
    name: Evaluate review outcome
    needs: [triage, claude-review]
    if: |
      always() && (
        github.event_name == 'pull_request' ||
        (github.event_name == 'issue_comment' && github.event.issue.pull_request != null && contains(github.event.comment.body, 'Claude finished'))
      )
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
    steps:
      - name: Resolve combined verdict
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR_NUMBER="${{ github.event.pull_request.number || github.event.issue.number }}"
          IS_PR_EVENT="${{ github.event_name == 'pull_request' }}"

          # --- Routine tier ---------------------------------------------------
          if [ "$IS_PR_EVENT" = "true" ]; then
            if [ "${{ needs.triage.outputs.reviewable }}" != "true" ]; then
              echo "::notice::Triage classified diff as non-reviewable — skipping routine read"
              ROUTINE_STATUS=skip
            elif [ "${{ needs.claude-review.result }}" != "success" ]; then
              echo "::error::Claude review job did not complete (result: ${{ needs.claude-review.result }})"
              exit 1
            else
              ROUTINE_STATUS=eval
            fi
          else
            ROUTINE_STATUS=eval
          fi

          if [ "$ROUTINE_STATUS" = "eval" ]; then
            ROUTINE_COMMENT=$(gh api "repos/${{ github.repository }}/issues/$PR_NUMBER/comments" \
              | jq -r '[.[] | select(.body | contains("## Code Review — {{PROJECT_NAME}}"))] | last | .body // ""')
            if [ -z "$ROUTINE_COMMENT" ]; then
              if [ "$IS_PR_EVENT" = "true" ]; then
                echo "::error::No routine review comment found"
                exit 1
              else
                echo "::notice::No routine review comment yet — issue_comment re-eval skipped"
                exit 0
              fi
            fi
            # Verdict is the last non-empty line per the prompt's
            # 'ending with EXACTLY one of' rule — checking the whole body
            # would false-fire when a 🟢 review recaps a prior 🔴 finding.
            ROUTINE_VERDICT_LINE=$(printf '%s\n' "$ROUTINE_COMMENT" | sed '/^[[:space:]]*$/d' | tail -n 1)
            if echo "$ROUTINE_VERDICT_LINE" | grep -qF "🔴"; then
              echo "::error::Routine review verdict: 🔴 Blocking"
              exit 1
            fi
            if ! echo "$ROUTINE_VERDICT_LINE" | grep -qF "🟢"; then
              echo "::error::Routine review comment has no clear 🔴/🟢 verdict on its last line"
              echo "::error::Last line was: $ROUTINE_VERDICT_LINE"
              exit 1
            fi
            echo "✅ Routine review verdict: 🟢 LGTM"
          fi

          # --- Deep tier — folded in only when needs-deep-review label is set -
          LABELS=$(gh pr view "$PR_NUMBER" --repo "${{ github.repository }}" --json labels --jq '[.labels[].name] | join(",")')
          if ! echo "$LABELS" | grep -q "needs-deep-review"; then
            echo "✅ Deep tier not required (no needs-deep-review label) — gate passes"
            exit 0
          fi

          DEEP_VERDICT=$(gh api "repos/${{ github.repository }}/issues/$PR_NUMBER/comments" \
            | jq -r '[.[] | select(.user.login == "claude[bot]") | select(.body | contains("Claude finished"))] | last | .body // ""')
          if [ -z "$DEEP_VERDICT" ]; then
            echo "::error::Deep tier escalated but verdict not yet posted — gate pending"
            echo "::error::Wait for deep tier, OR remove 'needs-deep-review' label to dismiss"
            exit 1
          fi
          DEEP_VERDICT_LINE=$(printf '%s\n' "$DEEP_VERDICT" | sed '/^[[:space:]]*$/d' | tail -n 1)
          if echo "$DEEP_VERDICT_LINE" | grep -qF "🔴"; then
            echo "::error::Latest deep tier verdict: 🔴 Blocking"
            echo "::error::Re-trigger with '@claude review this PR — depth pass on <focus>', OR remove 'needs-deep-review' label"
            exit 1
          fi
          if ! echo "$DEEP_VERDICT_LINE" | grep -qF "🟢"; then
            echo "::error::Deep tier comment has no clear 🔴/🟢 verdict on its last line"
            echo "::error::Last line was: $DEEP_VERDICT_LINE"
            exit 1
          fi
          echo "✅ Routine 🟢 + deep 🟢 — gate passes"
          exit 0

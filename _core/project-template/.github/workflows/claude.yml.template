# On-demand deep review
# Filters on body SIGNATURE (`@claude review this PR`), not author. The
# routine review's structured trigger comment (claude-code-review.yml
# Step 4.B) is posted by GITHUB_TOKEN — author = `claude[bot]`. Body
# content distinguishes it cleanly:
#   • Trigger comment body STARTS with `@claude review this PR — depth pass`.
#   • Progress comment body is `Claude Code is working…` and contains
#     `@claude` only inside backticks — never the literal substring
#     `@claude review this PR`.
#
# Merge gate participation: this workflow PATCHes the `Claude On-Demand`
# check-run on the PR HEAD SHA via the Checks API after the deep reviewer finishes its
# review. The check was created at status=in_progress by claude-code-review.yml's
# init-deep-check job; this workflow upgrades it to success/failure based on
# the deep verdict. When branch protection requires `Claude On-Demand` (the
# recommended config per claude-code-review.yml's POST-BIND PREREQUISITES),
# deep-tier verdicts actually gate merge. If `Claude On-Demand` is not in
# the required-checks ruleset, the check remains visible in the PR status
# panel but is advisory.
#
# POST-BIND PREREQUISITES (workflow is a no-op until BOTH are done):
#   1. Add CLAUDE_CODE_OAUTH_TOKEN to repo secrets
#      (GitHub UI: Settings → Secrets and variables → Actions → New repository secret).
#   2. This file must live on the repo's GITHUB DEFAULT BRANCH. If your repo's
#      default branch is not where day-to-day PRs target (e.g., Gitflow:
#      default={{MAIN_BRANCH}}, PRs target {{DEV_BRANCH}}), land this file on
#      {{MAIN_BRANCH}} first via a hotfix/* branch, then cascade
#      {{MAIN_BRANCH}} → {{DEV_BRANCH}}. Workflow files installed only on a
#      non-default branch will NEVER fire.

name: Claude On-Demand

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  pull_request_review:
    types: [submitted]

jobs:
  claude:
    name: On-demand (@claude → deep review)
    # Filter: accept comments whose body STARTS with `@claude review this PR`
    # AND does NOT start with `Claude Code is working`. The trigger is a
    # command, so it leads the comment: the routine review's Step 4.B trigger
    # starts with it. A comment that only quotes the phrase mid-text (a
    # routine verdict listing it among what it checked) must not fire a deep
    # run: such a run finds no trigger, fails the check closed, and can cancel
    # a real deep run through the concurrency group below.
    #
    # Note for humans triggering manually: start the comment with the exact
    # phrase `@claude review this PR` (not just `@claude review`). Matches
    # the canonical structured trigger format documented in
    # `.claude/rules/review-tiers.md`.
    # Anchor the bot-loop guard to startsWith — the action's progress comment
    # body STARTS with "Claude Code is working"; legitimate escalation
    # comments may quote the phrase when discussing the filter itself (e.g.
    # listing invariants for the deep tier to verify). Using `!contains` here would
    # reject any such quote and silently block the deep tier from firing.
    if: |
      (github.event_name == 'issue_comment' && startsWith(github.event.comment.body, '@claude review this PR') && !startsWith(github.event.comment.body, 'Claude Code is working')) ||
      (github.event_name == 'pull_request_review_comment' && startsWith(github.event.comment.body, '@claude review this PR') && !startsWith(github.event.comment.body, 'Claude Code is working')) ||
      (github.event_name == 'pull_request_review' && startsWith(github.event.review.body, '@claude review this PR') && !startsWith(github.event.review.body, 'Claude Code is working'))
    # CRITICAL: this MUST live at the job level (not workflow level). The
    # action's own progress comment ("Claude Code is working…") contains the
    # `@claude` substring, so workflow-level concurrency would accept it and
    # cancel the in-flight deep-tier review *before* the job-level `if:` had
    # a chance to filter it out. Job-level concurrency is evaluated AFTER
    # the job-level `if:`, so bot-comment runs that get filtered never enter
    # the concurrency group and can't preempt anything.
    concurrency:
      group: claude-on-demand-${{ github.event.issue.number || github.event.pull_request.number || github.run_id }}
      cancel-in-progress: true
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write
      actions: read
      # Needed to PATCH the `Claude On-Demand` check-run on the PR HEAD SHA
      # both at job start (in_progress) and after the deep review completes
      # (success/failure based on verdict).
      checks: write
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      # ── Resolve PR HEAD SHA once for downstream Checks API calls ──────────
      # claude.yml fires on issue_comment events, where the PR head SHA is
      # not directly in the event payload. Resolve it via the PR API and
      # expose it as a step output for the upsert + finalize steps.
      - name: Resolve PR HEAD SHA
        id: pr-head
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR_NUMBER="${{ github.event.issue.number || github.event.pull_request.number }}"
          if [ -z "$PR_NUMBER" ]; then
            echo "::notice::Not on a PR — skipping HEAD SHA resolution"
            echo "head_sha=" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          HEAD_SHA=$(gh api "repos/${{ github.repository }}/pulls/$PR_NUMBER" --jq '.head.sha')
          if [ -z "$HEAD_SHA" ]; then
            echo "::error::Could not resolve HEAD SHA for PR $PR_NUMBER"
            exit 1
          fi
          echo "pr_number=$PR_NUMBER" >> "$GITHUB_OUTPUT"
          echo "head_sha=$HEAD_SHA" >> "$GITHUB_OUTPUT"
          echo "::notice::PR #$PR_NUMBER HEAD SHA = $HEAD_SHA"

      # ── Upsert Claude On-Demand check to in_progress ──────────────────────
      # claude-code-review.yml's init-deep-check job created the check at
      # status=in_progress; routine auto-escalation may have already PATCHed
      # the title to "Deep review in progress". For manual `@claude review
      # this PR` triggers without a prior routine run on this HEAD SHA, the
      # check may not yet exist — create it. Either way, the PR's check
      # rollup now shows "Claude On-Demand: in_progress" while the deep reviewer runs.
      - name: Upsert Claude On-Demand check to in_progress
        if: steps.pr-head.outputs.head_sha != ''
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_SHA: ${{ steps.pr-head.outputs.head_sha }}
        run: |
          REPO="${{ github.repository }}"
          CHECK_ID=$(gh api \
            "repos/$REPO/commits/$HEAD_SHA/check-runs?check_name=Claude%20On-Demand&per_page=100" \
            --jq '[.check_runs[] | select(.name == "Claude On-Demand")] | first | .id // empty')
          if [ -n "$CHECK_ID" ]; then
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="in_progress" \
              -F "output[title]=Deep review in progress" \
              -F "output[summary]=The deep reviewer is running. This check will be updated to success/failure when the Evaluate deep-tier verdict step parses the completion comment."
            echo "::notice::Set existing Claude On-Demand check $CHECK_ID to in_progress"
          else
            gh api "repos/$REPO/check-runs" -X POST \
              -F name="Claude On-Demand" \
              -F head_sha="$HEAD_SHA" \
              -F status="in_progress" \
              -F "output[title]=Deep review in progress" \
              -F "output[summary]=Manual @claude trigger fired on a HEAD SHA with no prior routine run. The deep reviewer is running."
            echo "::notice::Created in_progress Claude On-Demand check on $HEAD_SHA"
          fi

      - name: Run Claude
        id: claude_attempt_1
        continue-on-error: true
        # Pinned to the v1 tag's resolved SHA (v1.0.213). The bare `@v1` floats,
        # and silent behavior changes from auto-updates burned other projects
        # already. Update via
        #   curl -s "https://api.github.com/repos/anthropics/claude-code-action/git/refs/tags/v1" | jq -r '.object.sha'
        # and bump the SHA here AND in `.github/workflows/claude-code-review.yml`
        # in one hotfix: both tiers carry the same pin.
        uses: anthropics/claude-code-action@7ada98c10deffc4c13fe5079693edf312888ff3b  # v1 (v1.0.213)
        # The token goes in both as a `with:` input and as an env var, the
        # upstream workaround for credential loss in tag mode.
        # `--disallowedTools` bans helper agents and wake-ups on every attempt:
        # a one-shot session that delegates ends with no verdict.
        env:
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: '--allowedTools "Bash(gh *),Bash(git diff*),Bash(git log*),Bash(git show*),Read" --disallowedTools "Agent,Task,ScheduleWakeup,SendMessage,ListAgents" --max-turns 120 --model {{REVIEW_DEEP_MODEL}} --effort {{REVIEW_DEEP_EFFORT}}'
          show_full_output: false
          additional_permissions: |
            actions: read
          allowed_bots: "claude"
          # Allow the routine review's `claude[bot]` to trigger this workflow: the
          # routine tier is the caller for deep-review escalations.
          # This action has no `system_prompt:` input. Claude Code loads
          # `CLAUDE.md` + `.claude/rules/*.md` from the checkout, and the
          # structured `@claude` comment from the routine review gives the
          # per-PR focus, invariants and the binary verdict rule.

      # ── Usage-limit exhaustion vs transient failure ──────────────────────
      # On a usage limit: skip the same-model retry and go to the backup model.
      # On any other failure: retry the same model first, then the backup only
      # if the retry also fails.
      - name: Detect failure class
        id: failure_class
        if: steps.claude_attempt_1.outcome == 'failure'
        run: |
          # The action saves the CLI's messages to a file on disk. Only two
          # fields of its final `result` message are read, both written by the
          # CLI: the API's HTTP status, and the result text when `is_error` is
          # set (then it is the API's error, not the model's words). Everything
          # else can carry the PR's own words: the job log prints the whole
          # prompt, the other messages hold the diff and comments, and the
          # result's own fields hold the model's final text and the commands it
          # was refused. A model cap returns HTTP 429, the plan cap reads
          # "You've hit your limit · resets …". A missing or unreadable file,
          # or a cap reported anywhere else, counts as transient: the cost is
          # one same-model retry.
          RESULT=$(jq -r '[.[]? | select(.type == "result")] | last // empty
            | "status=\(.api_error_status // "") \(if .is_error == true then .result // "" else "" end)"' \
            "$RUNNER_TEMP/claude-execution-output.json" 2>/dev/null || true)
          if printf '%s' "$RESULT" | grep -qiE '^status=429|rate_limit_error|usage limit|quota exceeded|resource_exhausted|(hit|reached) your [^.]{0,40}limit'; then
            echo "::warning::Usage limit detected in attempt 1 — skipping the same-model retry, falling back to the backup model"
            echo "usage_limit=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::Attempt 1 failure is not a usage limit — retrying the same model"
            echo "usage_limit=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Back off before attempt 2
        if: steps.claude_attempt_1.outcome == 'failure'
        run: sleep 90

      # Attempt 2a: same-model retry, for transient failures only.
      - name: Run Claude (retry)
        id: claude_retry
        if: steps.claude_attempt_1.outcome == 'failure' && steps.failure_class.outputs.usage_limit != 'true'
        continue-on-error: true
        uses: anthropics/claude-code-action@7ada98c10deffc4c13fe5079693edf312888ff3b  # v1 (v1.0.213)
        env:
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: '--allowedTools "Bash(gh *),Bash(git diff*),Bash(git log*),Bash(git show*),Read" --disallowedTools "Agent,Task,ScheduleWakeup,SendMessage,ListAgents" --max-turns 120 --model {{REVIEW_DEEP_MODEL}} --effort {{REVIEW_DEEP_EFFORT}}'
          show_full_output: false
          additional_permissions: |
            actions: read
          allowed_bots: "claude"

      # The backup runs on a job-private copy of the CLI at CLI_VERSION,
      # installed only when it is about to run, so a backup model newer than
      # the pinned action's own CLI is still accepted. Keep CLI_VERSION at or
      # above the version the backup model needs.
      - name: Install Claude Code for the backup reviewer
        id: claude-cli
        if: |
          (steps.failure_class.outputs.usage_limit == 'true') ||
          (steps.claude_retry.outcome == 'failure')
        continue-on-error: true
        shell: bash
        env:
          CLI_VERSION: "2.1.280"
        run: |
          set -euo pipefail
          for attempt in 1 2 3; do
            if curl -fsSL https://claude.ai/install.sh | bash -s -- "$CLI_VERSION"; then
              break
            fi
            if [ "$attempt" = 3 ]; then
              echo "::error::Claude Code $CLI_VERSION install failed three times"
              exit 1
            fi
            sleep 5
          done
          src="$HOME/.local/share/claude/versions/$CLI_VERSION"
          if [ ! -x "$src" ]; then
            src="$(readlink -f "$HOME/.local/bin/claude")"
          fi
          dest="$RUNNER_TEMP/claude-cli/claude"
          mkdir -p "$(dirname "$dest")"
          cp "$src" "$dest"
          chmod +x "$dest"
          installed="$("$dest" --version | awk '{print $1}')"
          if [ "$installed" != "$CLI_VERSION" ]; then
            echo "::error::expected Claude Code $CLI_VERSION, got '$installed'"
            exit 1
          fi
          echo "Claude Code $installed at $dest"
          echo "path=$dest" >> "$GITHUB_OUTPUT"

      # Attempt 2b: the backup model. Fires on a usage limit,
      # or when the same-model retry also failed. The Evaluate step below owns
      # the outcome, so every attempt continues on error.
      - name: Run Claude (backup)
        id: claude_fallback
        if: |
          steps.claude-cli.outcome == 'success' && (
          (steps.failure_class.outputs.usage_limit == 'true') ||
          (steps.claude_retry.outcome == 'failure'))
        continue-on-error: true
        uses: anthropics/claude-code-action@7ada98c10deffc4c13fe5079693edf312888ff3b  # v1 (v1.0.213)
        env:
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
        with:
          path_to_claude_code_executable: ${{ steps.claude-cli.outputs.path }}
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: '--allowedTools "Bash(gh *),Bash(git diff*),Bash(git log*),Bash(git show*),Read" --disallowedTools "Agent,Task,ScheduleWakeup,SendMessage,ListAgents" --max-turns 120 --model {{REVIEW_BACKUP_MODEL}} --effort {{REVIEW_BACKUP_EFFORT}}'
          show_full_output: false
          additional_permissions: |
            actions: read
          allowed_bots: "claude"

      - name: Evaluate deep-tier verdict
        # PATCH the `Claude On-Demand` check on the PR HEAD SHA to
        # success/failure based on the deep reviewer's verdict comment. When branch
        # protection requires `Claude On-Demand`, this PATCH is what
        # actually gates merge for auto-escalated PRs.
        #
        # The check was created on the PR HEAD SHA by claude-code-review.yml's
        # init-deep-check job (or by the Upsert step above for manual triggers).
        # Finding it by `(head_sha, name)` and PATCHing it keeps the check
        # attached to the PR HEAD SHA regardless of the issue_comment-event
        # check-run attachment quirk that breaks attempts to fold deep tier
        # via comment-correlation.
        #
        # The action posts a comment starting with "**Claude finished
        # @claude[bot]'s task in <duration>**" when the deep reviewer completes.
        # We re-read that comment and translate to check conclusion.
        if: always() && steps.pr-head.outputs.head_sha != ''
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ steps.pr-head.outputs.pr_number }}
          HEAD_SHA: ${{ steps.pr-head.outputs.head_sha }}
          # The model whose attempt completed, for the check title: the job name
          # and a green first step cannot tell (every attempt continues on
          # error). Keep these labels in step with the `--model` arguments above.
          REVIEWER: ${{ steps.claude_attempt_1.outcome == 'success' && '{{REVIEW_DEEP_MODEL}} {{REVIEW_DEEP_EFFORT}}' || steps.claude_retry.outcome == 'success' && '{{REVIEW_DEEP_MODEL}} {{REVIEW_DEEP_EFFORT}} (retry)' || steps.claude_fallback.outcome == 'success' && '{{REVIEW_BACKUP_MODEL}} {{REVIEW_BACKUP_EFFORT}} (backup)' || 'none' }}
        run: |
          REPO="${{ github.repository }}"

          # ── Stale-comment floor (current-run correlation) ─────────────────
          # `Evaluate deep-tier verdict` runs via `if: always()` even when
          # Run Claude failed silently (hit --max-turns, gh post failure,
          # network blip mid-completion-comment). The CHECK_ID lookup binds
          # to HEAD_SHA, but a naive `| last` on the comments endpoint would
          # pick the PRIOR push's stale 🟢 completion comment and PATCH the
          # current HEAD SHA's check to success based on an older verdict.
          # Filter comments by created_at >= this run's run_started_at to
          # reject completion comments from prior pushes (mirrors the same
          # pattern in claude-code-review.yml's evaluate-review-outcome).
          RUN_STARTED_AT=$(gh api "repos/$REPO/actions/runs/${{ github.run_id }}" --jq '.run_started_at')
          if [ -z "$RUN_STARTED_AT" ]; then
            echo "::error::Could not resolve current run's run_started_at — refusing to evaluate verdict without stale-comment floor"
            exit 1
          fi

          COMMENT=$(gh api --paginate "repos/$REPO/issues/$PR_NUMBER/comments" \
            | jq -r --arg ts "$RUN_STARTED_AT" \
                '[.[] | select(.user.login == "claude[bot]") | select(.body | startswith("**Claude finished")) | select(.created_at >= $ts)] | last | .body // ""')

          CHECK_ID=$(gh api \
            "repos/$REPO/commits/$HEAD_SHA/check-runs?check_name=Claude%20On-Demand&per_page=100" \
            --jq '[.check_runs[] | select(.name == "Claude On-Demand")] | first | .id // empty')
          if [ -z "$CHECK_ID" ]; then
            echo "::error::Claude On-Demand check not found on $HEAD_SHA — Upsert step must have failed"
            exit 1
          fi

          if [ -z "$COMMENT" ]; then
            # FAIL-CLOSED: neutral counts as passing in required status checks — failure blocks merge until a retry succeeds.
            echo "::error::No deep-tier completion comment found — every attempt errored or was skipped. Setting check to failure (fail-closed)."
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="completed" \
              -F conclusion="failure" \
              -F "output[title]=Deep review errored" \
              -F "output[summary]=The reviewer never ran to completion (attempt 1: ${{ steps.claude_attempt_1.outcome }}, usage limit: ${{ steps.failure_class.outputs.usage_limit }}, retry: ${{ steps.claude_retry.outcome || 'skipped' }}, backup: ${{ steps.claude_fallback.outcome || 'skipped' }}). This is not a blocking finding; nothing was judged. Retry with a comment starting with \`@claude review this PR — depth pass on <focus>\`. If the deep tier keeps failing, report it to the maintainer."
            exit 1
          fi

          # Verdict is the LAST line containing 🔴 or 🟢. Robust to recap text.
          VERDICT_LINE=$(printf '%s\n' "$COMMENT" | grep -E "🔴|🟢" | tail -n 1)
          if [ -z "$VERDICT_LINE" ]; then
            echo "::error::Deep-tier comment has no 🔴/🟢 verdict at all"
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="completed" \
              -F conclusion="failure" \
              -F "output[title]=Deep review verdict missing ($REVIEWER)" \
              -F "output[summary]=The deep reviewer ($REVIEWER) completed but did not include a 🔴/🟢 verdict line. Re-trigger with a comment starting with \`@claude review this PR\` and ensure the prompt mandates a binary verdict on the final line."
            exit 1
          fi

          if echo "$VERDICT_LINE" | grep -qF "🔴"; then
            echo "::error::Deep-tier verdict: 🔴 Blocking — merge blocked (reviewer: $REVIEWER)"
            gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
              -F status="completed" \
              -F conclusion="failure" \
              -F "output[title]=Deep review verdict: 🔴 Blocking ($REVIEWER)" \
              -F "output[summary]=The deep reviewer ($REVIEWER) returned a blocking verdict. Fix on the PR branch, then re-trigger with a comment starting with \`@claude review this PR — depth pass on <focus>\`. If the finding does not apply, explain why after the phrase in that comment, or in a separate comment first."
            exit 1
          fi

          echo "✅ Deep-tier verdict clean — PATCHing Claude On-Demand to success (reviewer: $REVIEWER)"
          gh api "repos/$REPO/check-runs/$CHECK_ID" -X PATCH \
            -F status="completed" \
            -F conclusion="success" \
            -F "output[title]=Deep review verdict: 🟢 LGTM ($REVIEWER)" \
            -F "output[summary]=The deep reviewer ($REVIEWER) signed off. Merge gate's deep-tier requirement satisfied."
          exit 0

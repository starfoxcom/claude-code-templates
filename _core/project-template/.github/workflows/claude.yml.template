# On-demand deep review — Opus 4.7
# Filters on body SIGNATURE (`@claude review this PR`), not author. The
# routine review's structured trigger comment (claude-code-review.yml
# Step 4.B) is posted by GITHUB_TOKEN — author = `claude[bot]`. Body
# content distinguishes it cleanly:
#   • Trigger comment body STARTS with `@claude review this PR — depth pass`.
#   • Progress comment body is `Claude Code is working…` and contains
#     `@claude` only inside backticks — never the literal substring
#     `@claude review this PR`.
#
# POST-BIND PREREQUISITES (workflow is a no-op until BOTH are done):
#   1. Add CLAUDE_CODE_OAUTH_TOKEN to repo secrets
#      (GitHub UI: Settings → Secrets and variables → Actions → New repository secret).
#   2. This file must live on the repo's GITHUB DEFAULT BRANCH. If your repo's
#      default branch is not where day-to-day PRs target (e.g., Gitflow:
#      default={{MAIN_BRANCH}}, PRs target {{DEV_BRANCH}}), land this file on
#      {{MAIN_BRANCH}} first via a hotfix/* branch, then cascade
#      {{MAIN_BRANCH}} → {{DEV_BRANCH}}. Workflow files installed only on a
#      non-default branch will NEVER fire.
#
# NOTE: The deep-tier verdict is advisory — it exits 1 on Opus 🔴, failing
# the `Claude On-Demand` check run, but that check is not in the required-
# checks ruleset. The single required check is `Evaluate review outcome` in
# claude-code-review.yml. A deep-tier 🔴 is a hard stop for the maintainer:
# read the finding before any admin-bypass.

name: Claude On-Demand

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  pull_request_review:
    types: [submitted]

jobs:
  claude:
    name: On-demand (@claude → Opus 4.7)
    # Filter: accept comments whose body contains `@claude review this PR`
    # AND does NOT contain `Claude Code is working`. Both conditions are
    # cheap string contains checks that catch the relevant edge cases.
    #
    # Note for humans triggering manually: the body must contain the exact
    # phrase `@claude review this PR` (not just `@claude review`). Matches
    # the canonical structured trigger format documented in
    # `.claude/rules/review-tiers.md`.
    if: |
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@claude review this PR') && !contains(github.event.comment.body, 'Claude Code is working')) ||
      (github.event_name == 'pull_request_review_comment' && contains(github.event.comment.body, '@claude review this PR') && !contains(github.event.comment.body, 'Claude Code is working')) ||
      (github.event_name == 'pull_request_review' && contains(github.event.review.body, '@claude review this PR') && !contains(github.event.review.body, 'Claude Code is working'))
    # CRITICAL: this MUST live at the job level (not workflow level). The
    # action's own progress comment ("Claude Code is working…") contains the
    # `@claude` substring, so workflow-level concurrency would accept it and
    # cancel the in-flight deep-tier review *before* the job-level `if:` had
    # a chance to filter it out. Job-level concurrency is evaluated AFTER
    # the job-level `if:`, so bot-comment runs that get filtered never enter
    # the concurrency group and can't preempt anything.
    concurrency:
      group: claude-on-demand-${{ github.event.issue.number || github.event.pull_request.number || github.run_id }}
      cancel-in-progress: true
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Run Claude
        # Pinned to v1's resolved SHA (resolved 2026-05-04). The bare `@v1`
        # floats — silent behavior changes from auto-updates burned other
        # projects already. Update via
        #   curl -s "https://api.github.com/repos/anthropics/claude-code-action/git/refs/tags/v1" | jq -r '.object.sha'
        # and bump the SHA here AND in `.github/workflows/claude-code-review.yml`.
        uses: anthropics/claude-code-action@8c196b2f61a66bfdf93322bde3a3e668669089ed  # v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: '--allowedTools "Bash(gh *),Read" --max-turns 50 --model claude-opus-4-7'
          # Allow the routine review's `claude[bot]` to trigger this workflow.
          # The bare action defaults to "humans only" as a bot-loop safety;
          # we explicitly opt in to claude → claude because the routine tier
          # is the canonical caller for deep-review escalations per
          # `.claude/rules/review-tiers.md`.
          allowed_bots: "claude"
          # NOTE: this action does NOT support a `system_prompt:` input.
          # Project context is auto-loaded by Claude Code from `CLAUDE.md` +
          # `.claude/rules/*.md` at repo root once the runner checks out. The
          # structured `@claude` comment from the routine review provides the
          # per-PR focus, invariants, and out-of-scope list.

      - name: Evaluate deep-tier verdict
        # Advisory enforcement. The routine tier's `Evaluate review outcome`
        # (in claude-code-review.yml) is the single REQUIRED status check that
        # gates merge. This step exits 1 on Opus 🔴, which fails the
        # `Claude On-Demand` check run and makes the red verdict visible in the
        # PR status panel — but that check is not in the required-checks
        # ruleset, so merge is not automatically blocked.
        #
        # What this means operationally: a deep-tier 🔴 is a hard stop for
        # the maintainer. Read the finding before any admin-bypass; never
        # bypass on a deep 🔴 without documenting why the finding is not
        # applicable or will be addressed in a follow-up.
        #
        # The action posts a comment starting with "**Claude finished
        # @claude[bot]'s task in <duration>**" when Opus completes its review.
        # We re-read that comment and exit red on 🔴.
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          PR_NUMBER="${{ github.event.issue.number || github.event.pull_request.number }}"
          if [ -z "$PR_NUMBER" ]; then
            echo "::notice::Not on a PR/issue — gate inapplicable"
            exit 0
          fi

          # 10-min cutoff so we only consider comments posted by THIS workflow
          # run, not stale completions from earlier runs. Opus typically takes
          # 3–4 min, so 10 min is generous.
          CUTOFF=$(date -u -d '10 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-10M +%Y-%m-%dT%H:%M:%SZ)

          # --paginate walks all pages — the issue-comments endpoint defaults
          # to per_page=30 and returns ascending order. On PRs with >30
          # existing comments the Opus completion comment lands on a later
          # page; without --paginate the advisory gate would silently pass
          # when there's actually a real 🔴 verdict to surface.
          COMMENT=$(gh api --paginate "repos/${{ github.repository }}/issues/$PR_NUMBER/comments" \
            | jq -r --arg cutoff "$CUTOFF" \
              '[.[] | select(.body | contains("Claude finished")) | select(.user.login == "claude[bot]") | select(.created_at >= $cutoff)] | last | .body // ""')

          if [ -z "$COMMENT" ]; then
            echo "::notice::No deep-tier completion comment in this run window — action skipped or fired on a non-review @claude mention; gate inapplicable"
            exit 0
          fi

          # Verdict is the LAST line containing 🔴 or 🟢. Robust to recap text.
          VERDICT_LINE=$(printf '%s\n' "$COMMENT" | grep -E "🔴|🟢" | tail -n 1)
          if [ -z "$VERDICT_LINE" ]; then
            echo "::error::Deep-tier comment has no 🔴/🟢 verdict at all"
            exit 1
          fi
          if echo "$VERDICT_LINE" | grep -qF "🔴"; then
            echo "::error::Deep-tier verdict: 🔴 Blocking — merge blocked"
            exit 1
          fi
          echo "✅ Deep-tier verdict clean"
          exit 0
